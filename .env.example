# ===========================================================================
# Docujet — environment template.
#
# Names only, no values. Copy to `.env` for local work; in production these
# are set in the Vercel project's Environment Variables screen.
#
# See docs/DEPLOYMENT-HANDOVER.md for where each value comes from.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase — REQUIRED. Without these the site cannot sign anyone in, cannot
# read the lead book, and cannot read the settings that resolve everything
# below. Environment-only: they can never be moved into the database, because
# they are what the database is reached with.
#
# Supabase dashboard > Project Settings > Data API  (URL)
# Supabase dashboard > Project Settings > API Keys  (the two keys)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# DeepSeek — the chat assistant's language model. Without it the assistant
# refuses every question. https://platform.deepseek.com
#
# A managed key: the running site prefers the value stored in the database
# (Superadmin > Settings > System Config) and falls back to this environment
# variable. Setting it here gives a first-boot default; afterwards it is
# rotated in the admin UI without a redeploy. See src/lib/settings/env.ts.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional. Defaults to deepseek-v4-flash when blank.
DEEPSEEK_MODEL=

# ---------------------------------------------------------------------------
# Local development only. Leave unset in production.
# ---------------------------------------------------------------------------

# Pins "today" (YYYY-MM-DD) so seeded demo data keeps a stable "this month".
# Set in production, the CRM reports the wrong date to everyone.
CRM_TODAY=

# Where the embedding model's weights are cached. Defaults to
# .cache/transformers, which the build primes and ships. Only set this if the
# host needs the cache somewhere else writable.
TRANSFORMERS_CACHE=

# Not read by the application. Kept for direct psql / connection-pooler access.
SUPABASE_DB_PASSWORD=
